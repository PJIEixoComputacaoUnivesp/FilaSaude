# Local AI agent tooling: `.agents/skills` is the source of truth for this
# project's skills. `.claude/skills` should be a symlink to it, but installers
# that don't preserve symlinks turn it into a real directory full of
# marketplace skills unrelated to this project — never commit that copy.
.claude/skills/
skills-lock.json
*.bak-[0-9]*

# code-reviewer agent: per-developer memory and last-review markers.
.agents/agent-memory
.last-review
.last-review.json
