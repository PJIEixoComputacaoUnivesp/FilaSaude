{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filasaude.example/contracts/occupancy-snapshot-v1.schema.json",
  "title": "FilaSaúde occupancy snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "unitCnes",
    "occurredAt",
    "observedAt",
    "categories"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Identificador ULID estável durante todas as retentativas."
    },
    "type": {
      "const": "occupancy.snapshot.v1"
    },
    "unitCnes": {
      "type": "string",
      "pattern": "^[0-9]{7}$",
      "description": "Código CNES da unidade representada pelo snapshot."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o estado ocorreu na origem."
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que a origem confirmou o estado."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/category"
      },
      "description": "Categorias aplicáveis ou informadas para a unidade."
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "capacity", "occupied"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["observation", "stabilization", "inpatient"]
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "occupied": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
