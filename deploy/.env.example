APP_DOMAIN=saude.example.com
IMAGE_TAG=latest
API_IMAGE=ghcr.io/pjieixocomputacaounivesp/filasaude-api
WEB_IMAGE=ghcr.io/pjieixocomputacaounivesp/filasaude-web
POSTGRES_DB=filasaude
POSTGRES_USER=filasaude
# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Optional. One login:token entry per administrator, comma-separated, turns on
# the admin endpoints that set a unit's position by hand. Use the GitHub login
# and a hexadecimal token (openssl rand -hex 32) so the value is safe in this
# file. A malformed list keeps the endpoints off.
# ADMIN_API_TOKENS=
