APP_DOMAIN=saude.example.com
IMAGE_TAG=latest
API_IMAGE=ghcr.io/pjieixocomputacaounivesp/filasaude-api
WEB_IMAGE=ghcr.io/pjieixocomputacaounivesp/filasaude-web
POSTGRES_DB=filasaude
POSTGRES_USER=filasaude
# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Optional. At least 32 characters turns on the admin endpoints that set a
# unit's position by hand. Without it they do not exist. Use hexadecimal
# (openssl rand -hex 32) so the value is safe in this file.
# ADMIN_API_TOKEN=
