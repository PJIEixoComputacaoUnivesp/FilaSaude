# Local development (compose.yaml). All values are optional; these are the defaults.
POSTGRES_DB=filasaude
POSTGRES_USER=filasaude
POSTGRES_PASSWORD=filasaude

# API connection when running the API outside Docker.
# The API process does not load this file automatically; export these values
# in the shell or use the Compose workflow, which injects them into the API.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filasaude
DB_USER=filasaude
DB_PASSWORD=filasaude

# Optional. At least 32 characters turns on the admin endpoints that set a
# unit's position by hand (/admin/location-corrections). Without it they do not
# exist (404). Generate with: openssl rand -hex 32
# ADMIN_API_TOKEN=
