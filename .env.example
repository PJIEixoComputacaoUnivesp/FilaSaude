# Local development (compose.yaml). All values are optional; these are the defaults.
POSTGRES_DB=filasaude
POSTGRES_USER=filasaude
POSTGRES_PASSWORD=filasaude

# API connection when running the API outside Docker.
# The API process does not load this file automatically; export these values
# in the shell or use the Compose workflow, which injects them into the API.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filasaude
DB_USER=filasaude
DB_PASSWORD=filasaude

# Optional. One login:token entry per administrator, comma-separated, turns on
# the admin endpoints that set a unit's position by hand. The login is the
# GitHub login; the token has at least 32 characters (openssl rand -hex 32). A
# malformed list keeps the endpoints off (404). Example:
# ADMIN_API_TOKENS=maria-souza:<64 hex characters>,joao:<64 hex characters>
# ADMIN_API_TOKENS=

# Webhook sources. Keep secrets outside version control. Each source can update
# only the listed CNES units. The JSON is an example and should be replaced in
# the deployment environment.
# WEBHOOK_SOURCE_CONFIG={"academic-simulator":{"secret":"replace-with-at-least-32-characters","unitCnes":["1234567"]}}
