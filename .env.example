# Local development (compose.yaml). All values are optional; these are the defaults.
POSTGRES_DB=filasaude
POSTGRES_USER=filasaude
POSTGRES_PASSWORD=filasaude

# API connection when running the API outside Docker.
# The API process does not load this file automatically; export these values
# in the shell or use the Compose workflow, which injects them into the API.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filasaude
DB_USER=filasaude
DB_PASSWORD=filasaude

# Optional. One login:token entry per administrator, comma-separated, turns on
# the admin endpoints that set a unit's position by hand. The login is the
# GitHub login; the token has at least 32 characters (openssl rand -hex 32). A
# malformed list keeps the endpoints off (404). Example:
# ADMIN_API_TOKENS=maria-souza:<64 hex characters>,joao:<64 hex characters>
# ADMIN_API_TOKENS=

# Webhook sources. Keep secrets outside version control. Each source can update
# only the listed CNES units. The JSON is an example and should be replaced in
# the deployment environment.
# WEBHOOK_SOURCE_CONFIG={"occupancy-feed":{"secret":"<openssl rand -hex 32>","unitCnes":["1234567"]}}

# Simulated occupancy (academic demonstration). "true" publishes GET /occupancy
# and the "Ocupação simulada" layer on the site; off by default.
# OCCUPANCY_SIMULATION_ENABLED=false
# Inbox processor; turn it off only to run it in another process.
# OCCUPANCY_PROCESSOR_ENABLED=true
# OCCUPANCY_PROCESSOR_INTERVAL_MS=2000
# OCCUPANCY_PROCESSOR_BATCH_SIZE=500
# OCCUPANCY_STALE_AFTER_MINUTES=20
# OCCUPANCY_HISTORY_HOURS=24
# OCCUPANCY_RETENTION_HOURS=168

# Local occupancy-feed simulator. These variables are read by the simulator
# process, not automatically by the API. Never commit a real secret. Without
# SIMULATOR_SOURCE_SECRET the simulator reads the secret, and without another
# selection the CNES sample, from WEBHOOK_SOURCE_CONFIG. The demonstration
# sample (one UPA in each of ten UFs) is in docs/simulator-testing.md.
# SIMULATOR_SOURCE_ID=occupancy-feed
# SIMULATOR_SOURCE_SECRET=<openssl rand -hex 32>
# SIMULATOR_SCENARIO=showcase
